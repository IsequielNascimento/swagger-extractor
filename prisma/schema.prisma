generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Snapshot {
  id          String         @id @default(uuid())
  apiName     String
  swaggerJson Json
  createdAt   DateTime       @default(now())
  diffsNew    SnapshotDiff[] @relation("SnapshotNew")
  diffsOld    SnapshotDiff[] @relation("SnapshotOld")
}

model SnapshotDiff {
  id            String   @id @default(uuid())
  snapshotOldId String
  snapshotNewId String
  diffJson      Json
  createdAt     DateTime @default(now())
  snapshotNew   Snapshot @relation("SnapshotNew", fields: [snapshotNewId], references: [id], onDelete: Cascade)
  snapshotOld   Snapshot @relation("SnapshotOld", fields: [snapshotOldId], references: [id], onDelete: Cascade)
}
